/*************/
/* IMPORT(S) */
/*************/
import java_cup.runtime.*;
import ast.*;
import java.util.List;
import java.util.ArrayList;
import java.util.Arrays;

parser code 
{:
	public Lexer lexer;

	public Parser(Lexer lexer)
	{
		super(lexer);
		this.lexer = lexer;
	}
	public void report_error(String message, Object info)
	{
		System.out.print("ERROR >> ");		
		System.out.print("[");
		System.out.print(lexer.getLine());
		System.out.print(":");
		System.out.print(lexer.getTokenStartPosition());
		System.out.print("]");		
		System.exit(0);
	}
:}

/************************/
/* CUSTOMIZE CUP PARSER */
/************************/
scan with
{:
	Symbol s;
	s = lexer.next_token();

	String tokenName = TokenNames.terminalNames[s.sym]; 
	StringBuilder sb = new StringBuilder(tokenName);

	if (s.sym == TokenNames.ID || s.sym == TokenNames.INT_LITERAL) {
		sb.append('(').append(s.value).append(')');
	} else if (s.sym == TokenNames.STRING_LITERAL) {
		sb.append("(\"").append(s.value).append("\")");
	}

	sb.append('[')
			.append(lexer.getLine())
			.append(',')
			.append(lexer.getTokenStartPosition())
			.append(']');
	String output = sb.toString();
	System.out.println(output);

	return s; 
:};



/*************/
/* TERMINALS */
/*************/
terminal PLUS;
terminal MINUS;
terminal TIMES;
terminal DIVIDE;
terminal LPAREN;
terminal RPAREN;
terminal LBRACK;
terminal RBRACK;
terminal LBRACE;
terminal RBRACE;
terminal COMMA;
terminal DOT;
terminal SEMICOLON;
terminal TYPE_INT;
terminal TYPE_STRING ;
terminal TYPE_VOID;
terminal ASSIGN;
terminal EQ;
terminal LT;
terminal GT;
terminal ARRAY;
terminal CLASS;
terminal RETURN;
terminal WHILE;
terminal IF;
terminal ELSE;
terminal NEW;
terminal EXTENDS;
terminal NIL;

/*************/
/* TERMINALS */
/*************/
terminal Integer INT_LITERAL;
terminal String STRING_LITERAL;
terminal String ID;

/*****************/
/* NON TERMINALS */
/*****************/
non terminal AstProg program;
non terminal AstDec dec;
non terminal AstType type;
non terminal AstVarDec varDec;
non terminal AstFuncDec funcDec;
non terminal List<AstParam> funcDec_params;
non terminal AstClassDec classDec;
non terminal List<AstDec> cField_list;
non terminal AstDec cField;
non terminal AstTypedef arrayTypedef;
non terminal AstNewExp newExp;
non terminal AstCallExp callExp;
non terminal List<AstExp> callExp_args;
non terminal AstExp exp;
non terminal AstVar var;
non terminal AstStmt stmt;
non terminal List<AstStmt> stmtList;

/***********************/
/* OPERATOR PRECEDENCE */
/***********************/

precedence nonassoc ASSIGN;
precedence left EQ;
precedence left LT, GT;
precedence left PLUS, MINUS;
precedence left TIMES, DIVIDE;
precedence nonassoc LBRACK; // Array indexing
precedence nonassoc LPAREN;  // Function call
precedence left DOT; // Field access

/************************/
/* START WITH: program */
/************************/
start with program;

/********************/
/* DERIVATION RULES */
/********************/

program ::= dec:d  {: RESULT = new AstProg(d); :}
		  | program:p dec:d {: p.addDeclaration(d); RESULT = p; :}
		  ;

dec ::= varDec:v {: RESULT = v; :}
      | funcDec:f {: RESULT = f; :}
      | classDec:c {: RESULT = c; :}
      | arrayTypedef:a {: RESULT = a; :}
      ;

type ::= TYPE_INT {: RESULT = AstType.INT(); :}
	   | TYPE_STRING {: RESULT = AstType.STRING(); :}
	   | TYPE_VOID {: RESULT = AstType.VOID(); :}
	   | ID:id {: RESULT = new AstType(id); :}
	   ;

varDec ::= type:t ID:id SEMICOLON {: RESULT = new AstVarDec(t, id); :}
		 | type:t ID:id ASSIGN exp:e SEMICOLON {: RESULT = new AstVarDec(t, id, e); :}
		 | type:t ID:id ASSIGN newExp:n SEMICOLON {: RESULT = new AstVarDec(t, id, n); :}
		 ;

funcDec ::= type:t ID:id LPAREN RPAREN LBRACE stmtList:sl RBRACE {: RESULT = new AstFuncDec(t, id, new ArrayList<>(), sl); :}
		  | type:t ID:id LPAREN funcDec_params:fp RPAREN LBRACE stmtList:sl RBRACE {: RESULT = new AstFuncDec(t, id, fp, sl); :}	
		  ;

funcDec_params ::= type:t ID:id {: RESULT = new ArrayList<>(Arrays.asList(new AstParam(t, id))); :}
				 | funcDec_params:fp COMMA type:t ID:id {: fp.add(new AstParam(t, id)); RESULT = fp; :}
				 ;

stmtList ::= stmt:s {: RESULT = new ArrayList<>(Arrays.asList(s)); :}
		   | stmtList:sl stmt:s {: sl.add(s); RESULT = sl; :}	
		   ;

classDec ::= CLASS ID:name LBRACE cField_list:cl RBRACE {: RESULT = new AstClassDec(name, null, cl); :}
           | CLASS ID:name EXTENDS ID:parent LBRACE cField_list:cl RBRACE {: RESULT = new AstClassDec(name, parent, cl); :}
           ;
		   
cField_list ::= cField:f {: RESULT = new ArrayList<>(Arrays.asList(f)); :}
			  | cField_list:cl cField:f {: cl.add(f); RESULT = cl; :}
			  ;

cField ::= varDec:v {: RESULT = v; :}
		 | funcDec:f {: RESULT = f; :}
		 ;

arrayTypedef ::= ARRAY ID:id EQ type:t LBRACK RBRACK SEMICOLON {: RESULT = new AstTypedef(id, t); :}
			   ;

exp ::= var:v {: RESULT = new AstExpVar(v); :}
	  | LPAREN exp:e RPAREN {: RESULT = e; :}
	  | exp:e1 PLUS exp:e2 {: RESULT = new AstExpBinop(e1, e2, BinOp.PLUS); :}
	  | exp:e1 MINUS exp:e2 {: RESULT = new AstExpBinop(e1, e2, BinOp.MINUS); :}
	  | exp:e1 TIMES exp:e2 {: RESULT = new AstExpBinop(e1, e2, BinOp.TIMES); :}
	  | exp:e1 DIVIDE exp:e2 {: RESULT = new AstExpBinop(e1, e2, BinOp.DIVIDE); :}
	  | exp:e1 LT exp:e2 {: RESULT = new AstExpBinop(e1, e2, BinOp.LT); :}
	  | exp:e1 GT exp:e2 {: RESULT = new AstExpBinop(e1, e2, BinOp.GT); :}
	  | exp:e1 EQ exp:e2 {: RESULT = new AstExpBinop(e1, e2, BinOp.EQ); :}
	  | callExp:ce {: RESULT = ce; :}
	  | INT_LITERAL:i {: RESULT = new AstExpInt(i); :}
	  | MINUS INT_LITERAL:i {: RESULT = new AstExpInt(-i); :}
	  | NIL {: RESULT = new AstExpNil(); :}
	  | STRING_LITERAL:s {: RESULT = new AstExpString(s); :}
	  ;

newExp ::= NEW type:t {: RESULT = new AstNewExp(t, null); :}
	     | NEW type:t LBRACK exp:e RBRACK {: RESULT = new AstNewExp(t, e); :}
		 ;

callExp ::= ID:name LPAREN RPAREN {: RESULT = new AstCallExp(null, name, new ArrayList<>()); :}
          | ID:name LPAREN callExp_args:args RPAREN {: RESULT = new AstCallExp(null, name, args); :}
          | var:v DOT ID:name LPAREN RPAREN {: RESULT = new AstCallExp(v, name, new ArrayList<>()); :}
          | var:v DOT ID:name LPAREN callExp_args:args RPAREN {: RESULT = new AstCallExp(v, name, args); :}
          ;

callExp_args ::= exp:e {: RESULT = new ArrayList<>(Arrays.asList(e)); :}
               | callExp_args:args COMMA exp:e {: args.add(e); RESULT = args; :}
			   ;

var ::= ID:name {: RESULT = new AstVarSimple(name); :}
	  | var:v DOT ID:field {: RESULT = new AstVarField(v, field); :}
	  | var:v LBRACK exp:e RBRACK {: RESULT = new AstVarSubscript(v, e); :}
	  ;

stmt ::= varDec:v {: RESULT = v; :}
       | var:v ASSIGN exp:e SEMICOLON {: RESULT = new AstStmtAssign(v, e); :}
       | var:v ASSIGN newExp:n SEMICOLON {: RESULT = new AstStmtAssign(v, n); :}
       | RETURN SEMICOLON {: RESULT = new AstStmtReturn(null); :}
       | RETURN exp:e SEMICOLON {: RESULT = new AstStmtReturn(e); :}
       | IF LPAREN exp:cond RPAREN LBRACE stmtList:then RBRACE {: RESULT = new AstStmtIf(cond, then, null); :}
       | IF LPAREN exp:cond RPAREN LBRACE stmtList:then RBRACE ELSE LBRACE stmtList:els RBRACE {: RESULT = new AstStmtIf(cond, then, els); :}
       | WHILE LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE {: RESULT = new AstStmtWhile(cond, body); :}
       | callExp:c SEMICOLON {: RESULT = new AstStmtCall(c); :}
       ;
